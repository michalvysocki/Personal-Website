---
import Base from "../layouts/Base.astro";
---

<Base title="Not found — Michał Wysocki">
  <section class="mx-auto max-w-2xl px-6 py-32">
    <h1 class="font-serif text-4xl">Not found</h1>

    <p class="mt-4 text-base text-muted">
      This page doesn't exist, or it moved.
    </p>

    <p class="mt-8 text-sm">
      <a
        href="/"
        class="border-b border-line pb-0.5 transition-colors hover:border-fg"
      >
        Back to home
      </a>
    </p>
  </section>
</Base>