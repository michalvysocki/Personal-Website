---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { data } = project;
---

<Base title={`${data.title} — Michał Wysocki`} description={data.description}>
  <article class="mx-auto max-w-2xl px-6 py-16">
    <div class="flex items-baseline justify-between gap-4">
      <h1 class="font-serif text-4xl">{data.title}</h1>
      <span class="shrink-0 text-sm text-muted">
        {data.inProgress ? "In progress" : data.year}
      </span>
    </div>

    <p class="mt-2 text-lg text-muted">{data.subtitle}</p>

    <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
      {
        data.links.map((l) => (
          <a
            href={l.href}
            class="border-b border-line pb-0.5 transition-colors hover:border-fg"
          >
            {l.label}
          </a>
        ))
      }
      <span class="text-muted">{data.tags.join(" · ")}</span>
    </div>

    <div class="prose mt-12">
      <Content />
    </div>
  </article>
</Base>