---
import { achievements } from "../data/achievements";
---

<section class="mx-auto max-w-2xl px-6 py-16">
  <h2 class="font-serif text-sm uppercase tracking-widest text-muted">
    Achievements
  </h2>

  <div class="mt-6">
    {
      achievements.map((a) => (
        <article class="border-t border-line py-6">
          <div class="flex items-baseline justify-between gap-4">
            <h3 class="text-base font-medium">{a.event}</h3>
            <span class="shrink-0 text-sm text-muted">{a.year}</span>
          </div>
          <p class="mt-0.5 text-base text-muted">{a.result}</p>
          <p class="mt-2 text-base leading-relaxed">{a.summary}</p>
        </article>
      ))
    }
  </div>
</section>