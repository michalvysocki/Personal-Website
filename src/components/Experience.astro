---
import { experience } from "../data/experience";
---

<section class="reveal mx-auto max-w-2xl px-6 py-16">
  <h2 class="font-serif text-sm uppercase tracking-widest text-muted">
    Experience
  </h2>

  <div class="mt-6 border-b border-line">
    {
      experience.map((r) => (
        <article class="border-t border-line py-6">
          <div class="flex items-baseline justify-between gap-4">
            <h3 class="text-base font-medium">{r.title}</h3>
            <span class="shrink-0 text-sm text-muted">{r.period}</span>
          </div>
          <p class="mt-0.5 text-base text-muted">{r.org}</p>
          <p class="mt-2 text-base leading-relaxed">{r.summary}</p>
        </article>
      ))
    }
  </div>
</section>