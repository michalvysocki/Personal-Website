---
import { getCollection } from "astro:content";
import ProjectCard from "./ProjectCard.astro";

const featured = (await getCollection("projects"))
  .filter((p) => p.data.featured)
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
---

<section class="mx-auto max-w-2xl px-6 py-16">
  <h2 class="font-serif text-sm uppercase tracking-widest text-muted">
    Selected Work
  </h2>

  <div class="mt-6">
    {featured.map((p) => <ProjectCard project={p} />)}
  </div>

    <p class="mt-8 text-sm">
      <a
        href="/projects"
        class="border-b border-line pb-0.5 transition-colors hover:border-fg"
      >
        All projects
      </a>
    </p>
</section>