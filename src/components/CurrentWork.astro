---
import { experience } from "../data/experience";

const current = experience[0];
---

<section class="mx-auto max-w-2xl px-6 py-16">
  <h2 class="font-serif text-sm uppercase tracking-widest text-muted">
    Currently
  </h2>

  <article class="mt-6 border-t border-line py-6">
    <div class="flex items-baseline justify-between gap-4">
      <h3 class="text-base font-medium">{current.title}</h3>
      <span class="shrink-0 text-sm text-muted">{current.period}</span>
    </div>
    <p class="mt-0.5 text-base text-muted">{current.org}</p>
    <p class="mt-2 text-base leading-relaxed">{current.summary}</p>
  </article>

  <p class="mt-8 text-sm">
    <a
      href="/cv"
      class="border-b border-line pb-0.5 transition-colors hover:border-fg"
    >
      Experience and education
    </a>
  </p>
</section>