---
const links = [
  { label: "Email", href: "mailto:michalwysocki.priv@proton.me" },
  { label: "GitHub", href: "https://github.com/michalvysocki" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/michalvysocki/" },
];

const year = new Date().getFullYear();
---

<footer class="mt-16 bg-inverse-bg text-inverse-fg">
  <div class="mx-auto max-w-2xl px-6 py-24">
    <h2 class="font-serif text-4xl">Get in touch</h2>

    <p class="mt-4 text-base text-inverse-muted">
      For research, engineering, or interesting problems.
    </p>

    <nav class="mt-10 flex flex-wrap gap-x-8 gap-y-3 text-base">
      {
        links.map((l) => (
          <a
            href={l.href}
            class="border-b border-inverse-line pb-1 transition-colors hover:border-inverse-fg"
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <p class="mt-16 text-sm text-inverse-muted">© {year} Michał Wysocki</p>
  </div>
</footer>