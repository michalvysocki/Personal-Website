---
import { education } from "../data/education";
---

<section class="mx-auto max-w-2xl px-6 py-16">
  <h2 class="font-serif text-sm uppercase tracking-widest text-muted">
    Education
  </h2>

  <div class="mt-6">
    {
      education.map((s) => (
        <article class="border-t border-line py-6">
          <div class="flex items-baseline justify-between gap-4">
            <h3 class="text-base font-medium">{s.field}</h3>
            <span class="shrink-0 text-sm text-muted">{s.period}</span>
          </div>
          <p class="mt-0.5 text-base text-muted">
            {s.institution} · {s.degree}
          </p>
        </article>
      ))
    }
  </div>
</section>